# Public URL of the deployed site (used for canonical URLs, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://renew-website-three.vercel.app

# Estimate form destination. Any endpoint that accepts a JSON POST and returns 2xx
# on success works — e.g. a Formspree form URL: https://formspree.io/f/xxxxxxxx
# Leave empty and the form validates but tells visitors it is not connected yet.
NEXT_PUBLIC_FORM_ENDPOINT=
